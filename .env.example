# Kaam25 settings - copy this file to .env and fill in your values, then restart the app.
# %NAME% parts (like %LOCALAPPDATA%) are expanded. Relative paths are inside the kaam25 folder.

# ---------- Web pages ----------
# Your project's TechInsights tickets page
TICKETS_URL=https://www.amdocs-ti.com/tmo/projects/<your-project>/tickets
# Opened directly; ActixOne only shows its login page when you're signed out
ACTIX_UPLOAD_URL=https://a1-cra.actixone.com/outdoor/upload
# Optional: TEMS Paragon on this PC (the extension only works on http://localhost:8080)
# TEMS_URL=http://localhost:8080/
# Optional: TEMS's map data service on this PC - Live Testing draws its map from it (read only)
# TEMS_DATA_URL=http://localhost:8181
# Optional: TEMS Cloud project that lists the WOs to reserve (changes each month)
# TEMS_PROJECT=SR_Y6_Oct_26_LM_Nokia
# Optional, TEMS test mode only: the Assign WO the test popup starts with
# TEMS_ASSIGN_WO=SO-LM-HN-02-9_G23d_2U_102326_NOKIA
# Optional: TEMS test mode. false (default, prod) = after a start, Reserve and Open the WO in TEMS for real;
# true = ask for a Cloud WO and an Assign WO and only check the buttons (nothing clicked)
# TEMS_TEST_MODE=false

# ---------- You ----------
# Your team / employee ID (only your team's rows are imported from the day's plan)
EMPLOYEE_ID=N000
# Account picked on Microsoft's "Pick an account" page when signing in to ActixOne
MICROSOFT_ACCOUNT=you@yourcompany.com
# Extra email added on the ActixOne upload page
ACTIX_EXTRA_EMAIL=team-drive-list@example.com

# ---------- Start Ticket defaults ----------
DEFAULT_REGION=South
DEFAULT_MARKET=HN
# "Logs uploaded from previous day" dropdown on the Create Ticket form
DEFAULT_LOGS_UPLOADED_PREVIOUS_DAY=Yes
# Drive Shift is picked when the ticket is created: PM from this time (local, 24h), AM before it
DRIVE_SHIFT_PM_FROM=14:00
# true = click Create and find the new Ticket ID; false = only fill the form
DEFAULT_SUBMIT=true

# ---------- End Ticket report defaults ----------
DEFAULT_TOTAL_GRIDS=1
DEFAULT_ATTEMPTED=1
DEFAULT_SKIPPED=0
# PASSED, SKIPPED or FAILED
DEFAULT_STATUS=PASSED
# Folder name line: <MMDDYYYY>_<EMPLOYEE_ID>_<FOLDER_NAME_PREFIX><WO>
FOLDER_NAME_PREFIX="Cloud WO - "

# ---------- Drive log files ----------
# Files come from <LOG_ROOT_DIR>\<equipment>\Cloud WO - <WO>\<newest numbered folder>
LOG_ROOT_DIR=C:\TemsParagon\Logfiles
# Comma-separated; uploaded in this order
EQUIPMENTS=EQ3,EQ6

# ---------- GridSummary copy (End Ticket, before ActixOne) ----------
# The WO's folder here, newest numbered subfolder, then GRID_SUMMARY_FILE is copied as
# <MMDDYYYY>_<EMPLOYEE_ID>_Cloud WO - <WO>.csv
WORK_ORDER_OUTPUT_DIR=%USERPROFILE%\Documents\TEMS Product Files\TEMS Paragon 10.1\WorkOrderOutput
GRID_SUMMARY_FILE=GridSummary.csv

# ---------- ActixOne upload ----------
# true = click Submit, wait for the upload and save its Job ID into EQ3 / EQ6; false = stop before Submit
ACTIX_SUBMIT=true

# ---------- Local ticket records ----------
# Everything Start / End Ticket do is saved here
TICKET_STORE_FILE=tickets.json

# ---------- WhatsApp sharing ----------
# Chat (group) name exactly as it shows in WhatsApp
WHATSAPP_GROUP=Your Group Name
# After the summary: "<WO> - Done" goes to this group (End Tickets: all WOs in one message). Blank = skip
WHATSAPP_GROUP_WO=
# Where the Send switch starts (you can flip it in Settings / End Ticket)
# false = attach the CSV and type the report, then stop so you press Send; true = also press Send
WHATSAPP_SEND=false
# true (default) = End shares on WhatsApp by itself once End Ticket / Upload got everything
WHATSAPP_AUTO_SHARE=true
# If a share fails, try again this many more times (5 s apart)
WHATSAPP_RETRIES=2

# ---------- Tabs ----------
# true = close the tab the app opened once its job is fully done
CLOSE_TABS_WHEN_DONE=true

# ---------- Chrome ----------
# First one that exists is used. Separate with ;
CHROME_PATHS=C:\Program Files\Google\Chrome\Application\chrome.exe;C:\Program Files (x86)\Google\Chrome\Application\chrome.exe;%LOCALAPPDATA%\Google\Chrome\Application\chrome.exe
# Used to find your last-used Chrome profile
CHROME_USER_DATA_DIR=%LOCALAPPDATA%\Google\Chrome\User Data
# true (default) = other devices on the same WiFi (e.g. a tablet) can open the app at http://<this PC's IP>:5000
# LAN_ACCESS=true

# ---------- App <-> extension ----------
# If you change this, also change 47821 in chromeExtension\background.js and manifest.json
BRIDGE_PORT=47821
DEBUG_LOG_FILE=kaamDebug.log

# ---------- Location (the WO box's QR icon) ----------
# false (default) = show the WO's Google Maps link as a QR code (scan to open the spot), the link and lat / long
# true = post the Maps link to Apeksha instead
# APEKSHA_ENABLED=false
# APEKSHA_URL=https://your-codeshare-site.example.com

# ---------- Teams (optional) ----------
# The Teams button at the top of every page opens this in a new tab (e.g. your meeting link)
# TEAMS_URL=https://teams.microsoft.com/meet/...

# ---------- Phones (Live Testing, Vysor / adb) ----------
# Each test phone's serial: run  adb devices  (or look in Vysor). In Vysor the phones must be
# named TMO 1 / TMO 2; TMO 1 goes on the left. Used by Live Testing and the .bat scripts.
# Also editable in Settings > Phones. See README "Your own test phones".
PHONE_TMO1=<serial>
PHONE_TMO2=<serial>
# Optional: label of the Speedtest shortcut on the phone's home screen
# PHONE_SPEEDTEST_LABEL=Speedtest
# Optional: Service Mode's share of the phone screen in the split (default 0.70 = 70:30)
# PHONE_SPLIT_RATIO=0.70
# Optional: seconds airplane mode stays on in Full test / Airplane (default 5)
# PHONE_AIRPLANE_SECONDS=5
# Optional: adb.exe to use (default: adb on PATH, else the one inside Vysor)
# PHONE_ADB=
